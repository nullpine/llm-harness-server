{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make dev)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(shellcheck *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/harness.env)",
      "Bash(az *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(./scripts/provision.sh*)",
      "Bash(./scripts/rotate-key.sh*)",
      "Bash(git push --force*)"
    ]
  }
}
