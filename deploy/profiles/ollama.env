# ollama — local Apple Silicon. The MVP path (docs/SPEC.md §4.3).
#
# Literal KEY=value, no shell expansion: these files double as systemd
# `EnvironmentFile=` on a real host. Precedence is handled by scripts/dev.sh —
# your shell environment wins, then .env.local, then this file.
#
# NO SECRETS HERE. This file is committed. HARNESS_API_KEY lives in .env.local
# (gitignored), which dev.sh generates on first run. See CLAUDE.md rule 5.

HARNESS_DEFAULT_BACKEND=ollama
HARNESS_OLLAMA_URL=http://127.0.0.1:11434
HARNESS_MODELS_FILE=deploy/config/models.yaml
HARNESS_STATE_DIR=.local
