# harness.env.example — the full HARNESS_* surface, for a real host.
#
# On a provisioned machine this is /etc/harness/harness.env, referenced by the
# systemd unit as `EnvironmentFile=`. Copy it, fill it in, and never commit the
# copy: it holds keys (CLAUDE.md rule 5).
#
# For *local development* you do not need this file. `make dev` composes the same
# variables from deploy/profiles/<name>.env plus your gitignored .env.local — see
# scripts/dev.sh. The formats are deliberately identical (literal KEY=value, no
# expansion) so a profile can be used verbatim as an EnvironmentFile.
#
# Every value below is the packaged default from settings.py unless noted.

# --- auth -------------------------------------------------------------------
# Required. Empty means "no key configured", which auth.py treats as
# deny-everything rather than allow-everything. Generate with:
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
HARNESS_API_KEY=

# --- catalog ----------------------------------------------------------------
HARNESS_MODELS_FILE=/etc/harness/models.yaml

# --- backend selection ------------------------------------------------------
# One of: ollama | vllm | remote_openai. Not cosmetic: while this says `ollama`
# the control plane refuses to start unless OLLAMA_MAX_LOADED_MODELS=1 is in its
# environment (app.assert_single_model_daemon), which on a GPU host is a check
# for a daemon that is not there.
HARNESS_DEFAULT_BACKEND=ollama

# --- backend: ollama --------------------------------------------------------
HARNESS_OLLAMA_URL=http://127.0.0.1:11434

# --- backend: vllm ----------------------------------------------------------
HARNESS_VLLM_BIN=/opt/harness/.venv/bin/vllm
HARNESS_VLLM_PORT=8000

# --- backend: remote_openai -------------------------------------------------
# The origin serving OpenAI routes, and the upstream's own key. The latter is a
# secret and is NOT our HARNESS_API_KEY: that one authenticates the desktop app
# to us and is meaningless upstream.
HARNESS_REMOTE_BASE_URL=
HARNESS_REMOTE_API_KEY=

# --- supervisor -------------------------------------------------------------
HARNESS_STATE_DIR=/var/lib/harness
HARNESS_DRAIN_TIMEOUT_S=30.0
HARNESS_LOAD_TIMEOUT_S=900.0
HARNESS_HEALTH_POLL_INTERVAL_S=2.0
# Restore the last model on boot.
HARNESS_AUTOLOAD_LAST=true
# Activate this model id at startup. Empty means "activate nothing".
HARNESS_AUTOLOAD_MODEL=

# --- logging ----------------------------------------------------------------
HARNESS_LOG_LEVEL=INFO
