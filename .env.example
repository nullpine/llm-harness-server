# Local development only. Copy to .env (gitignored) and edit.
# The VM's real config is deploy/config/harness.env.example → /etc/harness/harness.env
# (mode 0600, owner harness). Never commit a real key. See docs/SPEC.md §5.7.

# Any non-empty string works locally; production uses >= 32 random bytes base64url.
HARNESS_API_KEY=dev-key-not-a-secret

HARNESS_MODELS_FILE=deploy/config/models.yaml
HARNESS_STATE_DIR=.local/state

# `make dev` runs against tests/fake_vllm.py rather than a real vLLM.
HARNESS_VLLM_BIN=.venv/bin/python
HARNESS_VLLM_PORT=8000

HARNESS_DRAIN_TIMEOUT_S=5
HARNESS_LOAD_TIMEOUT_S=30
HARNESS_AUTOLOAD_LAST=false
